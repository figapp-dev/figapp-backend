# Railway production checklist (figapp-backend).
# Copy these NAMES into Railway → Variables. Fill real values there.
# Never commit a filled copy. Never put these in the web or Flutter apps.

NODE_ENV=production

# Same Supabase project as the live web app.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Browser CORS: scheme + host only — no path, no trailing slash.
# Live login is https://www.figapp.co.uk/auth → origin is https://www.figapp.co.uk
# Add https://figapp.co.uk as well if the app is also served without www.
CORS_ORIGINS=https://www.figapp.co.uk,https://figapp.co.uk

# Leave unset in production (Swagger off). Set true only for a short debug window.
# ENABLE_DOCS=false

# GoCardless: sandbox_… until you switch the GC dashboard to live.
# Live access tokens do not start with sandbox_.
GOCARDLESS_ACCESS_TOKEN=sandbox_YOUR_SANDBOX_OR_LIVE_TOKEN
GOCARDLESS_WEBHOOK_SECRET=YOUR_GOCARDLESS_WEBHOOK_SIGNING_SECRET
GOCARDLESS_ENV=sandbox

# openssl rand -hex 32 — same value in GitHub Actions secret BILLING_CRON_SECRET.
BILLING_CRON_SECRET=YOUR_64_CHAR_HEX_SECRET

# Optional. Without these, collect still suspends past_due agencies on day 29.
# RESEND_API_KEY=re_...
# BILLING_FROM_EMAIL=FigApp Billing <billing@figapp.co.uk>

# Optional. Railway injects PORT — do not set it.
# RATE_LIMIT_MAX=200
# RATE_LIMIT_WINDOW=1 minute
