# Local development. On Railway, set the same keys in Variables.
# Copy to .env and fill in real values (never commit .env).

PORT=8082
NODE_ENV=development

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Swagger UI at /docs — on by default outside production.
# Production: leave unset (off) or set ENABLE_DOCS=true temporarily.
# ENABLE_DOCS=true

# Browser CORS (Flutter native does not need this).
# Dev default: allow all. Prod default: disabled unless set.
# CORS_ORIGINS=https://app.figapp.co.uk,http://localhost:5173

# Rate limit (health is excluded). Defaults: 200 / 1 minute.
# RATE_LIMIT_MAX=200
# RATE_LIMIT_WINDOW=1 minute
