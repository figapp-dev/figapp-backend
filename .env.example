# Local development. On Railway, set the same keys in Variables.
# Copy to .env and fill in real values (never commit .env).

PORT=8082
NODE_ENV=development

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Privileged writes for GoCardless webhooks / billing sync (never ship to web or Flutter).
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Swagger UI at /docs — on by default outside production.
# Production: leave unset (off) or set ENABLE_DOCS=true temporarily.
# ENABLE_DOCS=true

# Browser CORS (Flutter native does not need this; the web app does).
# Origin = scheme + host only — no path (/auth is not part of it).
# Dev default: allow all. Prod default: disabled unless set.
# Local:
# CORS_ORIGINS=http://localhost:8081,http://localhost:5173
# Live (Railway): see .env.production.example
# CORS_ORIGINS=https://www.figapp.co.uk,https://figapp.co.uk

# GoCardless (UK Direct Debit). Sandbox tokens start with sandbox_.
# GOCARDLESS_ACCESS_TOKEN=sandbox_…
# GOCARDLESS_WEBHOOK_SECRET=
# GOCARDLESS_ENV=sandbox

# Railway cron: POST /internal/billing/collect daily (header x-billing-cron-secret).
# BILLING_CRON_SECRET=

# Rate limit (health is excluded). Defaults: 200 / 1 minute.
# RATE_LIMIT_MAX=200
# RATE_LIMIT_WINDOW=1 minute
